// Cloudflare Workers static-assets config for the home site.
// Deployed by Workers Builds on push to main: build with `npm run build -w apps/home`,
// then `npx wrangler deploy --config apps/home/wrangler.jsonc`.
// No Worker script: Cloudflare serves dist/ directly, honouring public/_headers.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nachogoca-com",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": false }
}
