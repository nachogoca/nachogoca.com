---
import { Image } from "astro:assets";
import Head from "@nachogoca/ui/Head.astro";
import Header from "@nachogoca/ui/Header.astro";
import Footer from "@nachogoca/ui/Footer.astro";
import portrait from "../assets/portrait.jpg";

const PHOTO_URL = "https://photo.nachogoca.com";
const email = import.meta.env.PUBLIC_CONTACT_EMAIL;

const social = [
  ...(email
    ? [{
        name: "Email",
        href: `mailto:${email}`,
        path: "M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z",
      }]
    : []),
  {
    name: "GitHub",
    href: "https://github.com/nachogoca",
    path: "M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z",
  },
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/gocaignacio",
    path: "M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z",
  },
];
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <Head
      title="Nacho González"
      description="Nacho González — software engineer and photographer."
      canonical="https://nachogoca.com/"
    />
  </head>
  <body>
    <Header logoText="home" logoHref="/" links={[{ href: PHOTO_URL, label: "Photography" }]} />
    <main class="hero">
      <Image
        src={portrait}
        alt="Portrait of Nacho González"
        widths={[200, 400]}
        sizes="200px"
        class="portrait"
        loading="eager"
        fetchpriority="high"
      />
      <h1>Nacho González</h1>
      <p class="subtitle">Software engineer</p>
      <ul class="social" aria-label="Contact and profiles">
        {social.map((s) => (
          <li>
            <a href={s.href} title={s.name} rel={s.href.startsWith("http") ? "noopener me" : undefined}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.path} /></svg>
              <span class="visually-hidden">{s.name}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="photo-link"><a href={PHOTO_URL}>Photography &rarr;</a></p>
    </main>
    <Footer />
  </body>
</html>

<style>
  .hero {
    flex: 1 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px 16px;
  }
  .portrait {
    width: 200px;
    height: 200px;
    max-width: 50vw;
    max-height: 50vw;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: 50%;
  }
  h1 { font-size: clamp(2rem, 6vw, 2.625rem); margin: 1.25rem 0 0.25rem; }
  .subtitle { margin: 0 0 1.25rem; }
  .social { list-style: none; display: flex; gap: 1.25rem; padding: 0; margin: 0; }
  .social a { display: inline-flex; padding: 4px; }
  .social svg { width: 22px; height: 22px; fill: currentColor; }
  .photo-link { margin-top: 2rem; }
  .photo-link a { text-decoration: none; border-bottom: 1px solid var(--rule); padding-bottom: 2px; }
  .photo-link a:hover { border-color: var(--accent); }
</style>
