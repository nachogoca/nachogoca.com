---
import { src, srcset, type Photo } from "../lib/manifest";

interface Props {
  photo: Photo;
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { photo, sizes, eager = false, class: className } = Astro.props;
const fallbackWidth = photo.widths.find((w) => w >= 1600) ?? photo.widths.at(-1)!;
---
<picture class={className}>
  {photo.formats.includes("avif") && <source type="image/avif" srcset={srcset(photo, "avif")} sizes={sizes} />}
  <img
    src={src(photo, fallbackWidth, "jpg")}
    srcset={srcset(photo, "jpg")}
    sizes={sizes}
    width={photo.w}
    height={photo.h}
    alt={photo.alt}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={eager ? "high" : undefined}
    style={`background-color:${photo.color}`}
  />
</picture>
